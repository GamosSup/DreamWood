# Дримвуд на своём сервере: сайт + прокси к базе (Supabase) + облако (Google Drive) + шрифты
{$DOMAIN} {
	encode zstd gzip
	root * /srv/dreamwood

	handle /sb/* {
		uri strip_prefix /sb
		reverse_proxy https://bvlwpfmtcdgfsomvwqrp.supabase.co {
			header_up Host {upstream_hostport}
			flush_interval -1
			transport http {
				dial_timeout 8s
				response_header_timeout 60s
			}
		}
	}

	# облако (Google Drive): те же функции, что в Cloudflare-версии, запущены на этом сервере (deploy/server.js).
	# Пока ключи Google не внесены, сервер отвечает 501 и приложение использует запасной путь.
	handle /api/* {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
			transport http {
				response_header_timeout 15m
			}
		}
	}

	# скрипт supabase-js и шрифты лежат на самом сервере (скачиваются при установке)
	handle /v/sbjs {
		root * /srv/vendor
		rewrite * /sbjs
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle /v/fonts {
		root * /srv/vendor
		rewrite * /fonts.css
		header Content-Type "text/css; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		file_server
	}
	handle_path /v/f/* {
		root * /srv/vendor/f
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header /sw.js Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
